# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=my_user
MYSQL_PASSWORD=my_password
MYSQL_DATABASE=my_database
MYSQL_CONNECTION_LIMIT=10

# Guardrails (leave unset/false to keep the tool read-only)
MYSQL_ALLOW_WRITE_OPERATIONS=false
MYSQL_ALLOW_DDL_OPERATIONS=false

# HTTP server bind (defaults shown; usually no need to override for local dev)
HOST=0.0.0.0
PORT=3000
